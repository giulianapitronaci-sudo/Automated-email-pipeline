    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are a professional commercial email copywriter for YOUR_COMPANY. You write in a professional yet warm tone. IMPORTANT: Do NOT mention any specific technologies or products — those go in a separate section of the email. Only write the personalized greeting line.",
              "role": "system"
            },
            {
              "content": "==Write ONE single personalized greeting line for:\n- Name: {{ $('📋 Read contacts (Google Sheets)').item.json['First Name'] }} {{ $('📋 Read contacts (Google Sheets)').item.json['Last Name'] }}\n- Segment: {{ $('📋 Read contacts (Google Sheets)').item.json['Segment'] }}\n\nDeduce gender from the first name. Use 'Dear Mr./Ms. [Last Name],' for formal segments, 'Dear [First Name] [Last Name],' for others.\n\nOnly the greeting line, nothing else."
            }
          ]
        },
        "options": {
          "maxTokens": 400,
          "temperature": 0.7
        }
      },
      "id": "965e2400-7138-48c7-8cc6-878ef67731f9",
      "name": "🤖 ChatGPT generates greeting",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [
        928,
        0
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('📋 Read contacts (Google Sheets)').item.json.Email }}",
        "subject": "=YOUR_COMPANY — Latest Innovations for {{ $('📋 Read contacts (Google Sheets)').item.json['Company'] }}",
        "message": "=<div style=\"font-family: 'Helvetica Neue', Arial, sans-serif; max-width: 620px; margin: 0 auto; background: #ffffff;\">\n\n  <div style=\"background-color: #f8fafc; padding: 28px 40px; text-align: center; border: 1px solid #e2e8f0; border-bottom: none; border-radius: 8px 8px 0 0;\">\n    <img src=\"https://raw.githubusercontent.com/YOUR_GITHUB_USER/YOUR_REPO/main/your-logo.png\" alt=\"YOUR_COMPANY\" style=\"height: 55px;\"/>\n  </div>\n\n  <div style=\"padding: 40px 40px 32px 40px; border: 1px solid #e2e8f0; border-top: none; border-bottom: none;\">\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0 0 24px 0;\">{{ $json.message.content }}</p>\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0 0 16px 0; text-align: justify;\">We are pleased to present the latest innovations from YOUR_COMPANY, a reference in the industry with over 50 years of experience in the design of specialized solutions.</p>\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0 0 12px 0;\">We position ourselves at the forefront of the industry through the integration of unique technologies:</p>\n\n    <ul style=\"font-size: 15px; color: #1a202c; line-height: 2; padding-left: 20px; margin: 0 0 24px 0; text-align: justify;\">\n      <li><strong>[Technology 1]:</strong> Brief description of the technology and its key benefit.</li>\n      <li><strong>[Technology 2]:</strong> Brief description of the technology and its key benefit.</li>\n      <li><strong>[Technology 3]:</strong> Brief description of the technology and its key benefit.</li>\n      <li><strong>[Technology 4]:</strong> Brief description of the technology and its key benefit.</li>\n    </ul>\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0 0 16px 0; text-align: justify;\">Our decades of experience allow us to offer tailored solutions, combining tradition with the latest technologies available worldwide.</p>\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0 0 16px 0; text-align: justify;\">Would you be interested in scheduling a brief meeting or receiving our technical catalogue?</p>\n\n    <p style=\"font-size: 15px; color: #1a202c; line-height: 1.8; margin: 0; text-align: justify;\">We remain at your disposal.</p>\n\n  </div>\n\n  <div style=\"background: #f8fafc; padding: 24px 40px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 8px 8px;\">\n    <p style=\"margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: #0d1f4e;\">YOUR_NAME</p>\n    <p style=\"margin: 0 0 12px 0; font-size: 13px; color: #64748b;\">YOUR_TITLE — YOUR_COMPANY</p>\n    <p style=\"margin: 0 0 4px 0; font-size: 12px; color: #64748b;\">📍 YOUR_ADDRESS</p>\n    <p style=\"margin: 0 0 4px 0; font-size: 12px; color: #64748b;\">📞 YOUR_PHONE_1 &nbsp;|&nbsp; YOUR_PHONE_2</p>\n    <p style=\"margin: 0; font-size: 12px;\">\n      <a href=\"mailto:your@email.com\" style=\"color: #0d1f4e; font-weight: 600; text-decoration: none;\">your@email.com</a>\n      &nbsp;|&nbsp;\n      <a href=\"http://www.yourcompany.com\" style=\"color: #0d1f4e; font-weight: 600; text-decoration: none;\">www.yourcompany.com</a>\n    </p>\n    <hr style=\"border: none; border-top: 1px solid #e2e8f0; margin: 20px 0 16px 0;\">\n    <p style=\"font-size: 10px; color: #94a3b8; margin: 0; line-height: 1.6;\">This email is confidential and intended solely for the addressee. If you received it in error, please notify us at <a href=\"mailto:your@email.com\" style=\"color: #94a3b8;\">your@email.com</a></p>\n  </div>\n\n</div>",
        "options": {
          "replyTo": "your@email.com"
        }
      },
